# Tier 1 monitoring redesign (CLAUDE.md "Session update ... 2026-09-04,
# spec/playbook v76") — fires trading-bot-digest.service at 17:30
# America/New_York, weekdays only, 30 minutes after Track B/Track C's
# shared 17:00 America/New_York post-close slot so both daily jobs have
# finished first.
#
# Anchored to America/New_York, matching trading-bot-daily.timer's and
# trading-bot-track-c.timer's own anchoring exactly, so the 30-minute
# offset holds year-round with no DST drift between them.
#
# Requires systemd >= 239 for the per-line OnCalendar= timezone suffix —
# see trading-bot-daily.timer's header for the older-systemd fallback.
[Unit]
Description=Run trading-bot-digest.service every weekday, 30 minutes after the shared daily post-close slot

[Timer]
OnCalendar=Mon..Fri *-*-* 17:30:00 America/New_York
Persistent=false
AccuracySec=1min

[Install]
WantedBy=timers.target
