# ==========================================
# Environment
# ==========================================
# Controls which Alpaca endpoint/keys are active. Every part of the bot should
# read this flag via config.py — never hardcode paper vs live anywhere else.
TRADING_ENV=paper          # paper | live

# ==========================================
# Alpaca — Paper
# ==========================================
ALPACA_PAPER_API_KEY=your_paper_key_id_here
ALPACA_PAPER_SECRET_KEY=your_paper_secret_key_here
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# ==========================================
# Alpaca — Live (leave blank until actually promoting to live, spec §2/§3.3)
# ==========================================
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# ==========================================
# Telegram
# ==========================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# ==========================================
# Trading parameters (mirrors spec §4 guardrails — locked decisions, v4/v5/v6)
# Do not change these values casually; they should trace back to a versioned
# spec update, not a code-only tweak.
# ==========================================
MAX_RISK_PER_TRADE_PCT=1.0
MAX_POSITION_SIZE_PCT=25.0
MAX_DAILY_LOSS_PCT=3.0
MAX_TRADES_PER_DAY=6
MAX_COMBINED_OPEN_RISK_PCT=1.5
MAX_DRAWDOWN_PCT=10.0

# Track B guardrail overrides (spec v32, locked) — layered on top of the
# global numbers above, not a replacement; crypto/Track A still read the
# global numbers. Rescaled for Track B's daily-bar/8-symbol cadence
# instead of the legacy intraday-crypto framing. No MAX_DRAWDOWN_PCT
# override — stays at the global 10%, not cadence-dependent.
MAX_TRADES_PER_DAY_TRACK_B=8
MAX_DAILY_LOSS_PCT_TRACK_B=4.0
MAX_TOTAL_OPEN_RISK_PCT_TRACK_B=8.0

# EMA / ATR — placeholders, not yet locked (playbook v6 §7, pending backtest)
EMA_FAST_PERIOD=9
EMA_SLOW_PERIOD=21
ATR_MULTIPLIER=

# ==========================================
# Monitoring — dead-man's-switch heartbeat (spec v34 §10.6)
# ==========================================
# Healthchecks.io "push"/heartbeat monitor URL, pinged once at the end of
# every trading-bot-daily.service run that completes with no per-step
# errors (src/execution.py's __main__ -> send_daily_heartbeat()).
# Healthchecks.io alerts if no ping arrives within its configured window
# (~26h) — catches the daily job/timer not running at all (host down,
# timer disabled, crash before completion), which none of the existing
# in-job Telegram alerts can catch since those only fire from inside a
# run that's already happening. Must be filled in with a real monitor
# URL for the heartbeat to do anything — if left blank, execution.py
# logs a warning and skips the ping rather than failing the job (see
# get_heartbeat_config()'s docstring, src/config.py, for why this is
# read as optional at the code level despite being required here).
# Separate from the fill-listener liveness heartbeat below.
HEALTHCHECKS_DAILY_HEARTBEAT_URL=your_healthchecks_daily_heartbeat_url_here

# Healthchecks.io heartbeat monitor URL for the fill-protection listener
# (trading-bot-listener.service) itself — pinged every 5 minutes by
# src/fill_listener.py's heartbeat_loop() while MonitoredTradingStream's
# connection is healthy (consecutive-failure count below its own 5-failure
# alert threshold). Configure this Healthchecks.io monitor's alert window at
# ~15 minutes (3 missed pings) — narrower than the daily job's ~26h window
# above, since this is a continuously-running process where a missed
# heartbeat is meaningful within minutes. Catches the listener process
# itself being down (crashed, crash-looped past systemd's
# StartLimitBurst, host down) — a failure mode the listener's own
# in-process URGENT reconnect-failure alert cannot catch, since that
# alert only fires from inside a still-running process. If left blank,
# fill_listener.py logs a warning and skips the ping rather than failing
# (see get_listener_heartbeat_config()'s docstring, src/config.py).
HEALTHCHECKS_LISTENER_HEARTBEAT_URL=your_healthchecks_listener_heartbeat_url_here

# ==========================================
# Logging (spec v42 §10.11, daily-job per-symbol DEBUG-logging milestone)
# ==========================================
# Process log level for execution.py's main() (get_log_level(), src/
# config.py). Defaults to INFO, matching the level hardcoded before this
# milestone, so leaving this unset/blank reproduces the exact prior
# behavior. Set to DEBUG to see per-symbol fetch/signal-evaluation detail
# during the daily job — the existing INFO-level run summary line is
# unaffected either way.
LOG_LEVEL=INFO
